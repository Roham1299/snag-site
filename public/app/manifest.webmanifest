{
  "name": "Snag",
  "short_name": "Snag",
  "description": "Send links to Snag on your computers from anywhere, and watch their downloads.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#0e0f11",
  "theme_color": "#0e0f11",
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    {
      "src": "/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/app/",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
