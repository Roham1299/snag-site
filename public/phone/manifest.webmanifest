    { "src": "/phone/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/phone/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/phone/",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
